@using Microsoft.AspNetCore.Components.Authorization

<header class="admin-topbar sticky-top border-bottom bg-body">
    <div class="container-fluid d-flex align-items-center gap-3 py-2">
        <button class="btn btn-outline-secondary d-none d-lg-inline" @onclick="OnToggleSidebar">
            <i class="bi bi-layout-sidebar-inset"></i>
        </button>

        <nav aria-label="breadcrumb" class="flex-grow-1">
            <ol class="breadcrumb m-0">
                <li class="breadcrumb-item"><a href="/seller/dashboard">Seller</a></li>
                <li class="breadcrumb-item active" aria-current="page">@CurrentPageTitle</li>
            </ol>
        </nav>

        <div class="ms-auto d-flex align-items-center gap-2">
            <div class="d-none d-md-flex" role="search">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input class="form-control" placeholder="Search…" />
                </div>
            </div>

            <button class="btn btn-sm btn-outline-secondary" title="Light/Dark" @onclick="OnToggleTheme">
                <i class="bi bi-moon-stars"></i>
            </button>

            <div class="dropdown">
                <button class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown">
                    <i class="bi bi-person-circle me-1"></i> @DisplayName
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="/seller/settings">Profile</a></li>
                    <li><a class="dropdown-item" href="/seller/settings">Settings</a></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li><a class="dropdown-item" href="/logout">Logout</a></li>
                </ul>
            </div>
        </div>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnToggleSidebar { get; set; }
    [Parameter] public EventCallback OnToggleTheme { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthStateTask { get; set; }
    private string DisplayName = "Seller";

    // Tuỳ bạn set title động bằng NavigationManager/RouteData, tạm để rỗng
    private string CurrentPageTitle => "";

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask is not null)
        {
            var user = (await AuthStateTask).User;
            DisplayName = user?.Identity?.Name
                          ?? user?.FindFirst("name")?.Value
                          ?? "Seller";
        }
    }
}
