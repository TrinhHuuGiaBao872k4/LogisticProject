@page "/register"
@layout EmptyLayout
@inject RegisterService registerService
@inject NavigationManager nav

<EditForm Model="registerModel" OnValidSubmit="HandleRegister">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="d-flex justify-content-center align-items-center vh-100 ">
        <div class="card p-4 shadow rounded-4" style="width: 450px;">
            <h4 class="mb-4 text-center text-dark">Đăng Ký Tài Khoản</h4>

            <InputText @bind-Value="registerModel.HoTen" class="form-control mb-2" placeholder="Họ tên"
                maxlength="50" />

            <InputDate @bind-Value="registerModel.NgaySinh" class="form-control mb-2"
                max="@DateTime.Today.AddYears(-16).ToString("yyyy-MM-dd")" />

            <InputText @bind-Value="registerModel.CCCD" class="form-control mb-2" placeholder="CCCD" maxlength="12"
                inputmode="numeric" oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,12)" />

            <InputText @bind-Value="registerModel.DiaChi" class="form-control mb-2" placeholder="Địa chỉ"
                maxlength="200" />

            <InputText @bind-Value="registerModel.SDT" class="form-control mb-2" placeholder="Số điện thoại"
                maxlength="11" inputmode="numeric" oninput="this.value=this.value.replace(/[^0-9]/g,'').slice(0,10)" />

            <InputText @bind-Value="registerModel.TenDanhNhap" class="form-control mb-2" placeholder="Tên đăng nhập"
                maxlength="30" />

            <InputText @bind-Value="registerModel.MatKhau" type="password" class="form-control mb-3"
                placeholder="Mật khẩu" maxlength="100" />

            <button type="submit" class="btn btn-primary w-100">Đăng ký</button>

            @if (!string.IsNullOrEmpty(message))
            {
                <div class="alert alert-info mt-3">@message</div>
            }

            <p class="text-center mt-3">
                <a href="/login" class="text-decoration-none">Đã có tài khoản? Đăng nhập</a>
            </p>
        </div>
    </div>
</EditForm>

@code {
    private UserRegisterViewModel registerModel = new();
    private string message = "";

    private async Task HandleRegister()
    {
        try
        {
            if (registerModel.NgaySinh == null || registerModel.NgaySinh == DateTime.MinValue)
            {
                message = "⛔ Ngày sinh không được để trống hoặc không hợp lệ.";
                return;
            }

            Console.WriteLine("🚀 Gửi đăng ký với:");
            Console.WriteLine($"Tên: {registerModel.HoTen}, Ngày sinh: {registerModel.NgaySinh:yyyy-MM-dd}");

            var result = await registerService.Register(registerModel);

            if (result == null)
            {
                message = "❌ Không thể kết nối đến máy chủ.";
                return;
            }

            if (result.statusCode == 200)
            {
                message = "🎉 Đăng ký thành công! Chuyển sang đăng nhập...";
                await Task.Delay(2000);
                nav.NavigateTo("/login");
            }
            else
            {
                message = $"❌ Đăng ký thất bại: {result.messsage}";
            }
        }
        catch (Exception ex)
        {
            message = $"🔥 Lỗi khi đăng ký: {ex.Message}";
            Console.WriteLine($"❌ Exception: {ex}");
        }
    }
}