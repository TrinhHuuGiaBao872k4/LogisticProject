@* @attribute [Authorize(Roles="Seller")] *@
@layout SellerLayout
@page "/seller/dashboard"

<h3 class="mb-4">Seller Dashboard</h3>

<div class="row g-4">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card card-stat p-3 hover-lift">
            <div class="d-flex align-items-center">
                <div class="icon text-primary me-3"><i class="bi bi-bag-check"></i></div>
                <div>
                    <div class="text-muted small">Orders (Today)</div>
                    <div class="fs-4 fw-semibold">23</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3 hover-lift">
        <div class="card card-stat p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-success me-3"><i class="bi bi-currency-dollar"></i></div>
                <div>
                    <div class="text-muted small">Revenue (Today)</div>
                    <div class="fs-4 fw-semibold">12,300,000</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3 hover-lift">
        <div class="card card-stat p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-warning me-3"><i class="bi bi-box-seam"></i></div>
                <div>
                    <div class="text-muted small">Low Stock</div>
                    <div class="fs-4 fw-semibold">7</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3 hover-lift">
        <div class="card card-stat p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-info me-3"><i class="bi bi-graph-up"></i></div>
                <div>
                    <div class="text-muted small">Conversion Rate</div>
                    <div class="fs-4 fw-semibold">4.8%</div>
                </div>
            </div>
        </div>
    </div>
</div>
