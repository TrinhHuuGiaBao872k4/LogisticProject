@page "/auth-redirect"
@inject TokenState TokenState
@inject NavigationManager Nav

@code{
    //điều hướng dựa trên role
    protected override Task OnInitializedAsync()
    {
        var token = TokenState.AccessToken;
        if (string.IsNullOrWhiteSpace(token))
        {
            Nav.NavigateTo("/", true);
            return Task.CompletedTask;
        }

        var roles = JwtHelper.GetRoles(token);
        if (roles.Any(r => r.Equals("Admin", StringComparison.OrdinalIgnoreCase)))
        {
            Nav.NavigateTo("/admin/dashboard", true);
        }
        else if (roles.Any(r => r.Equals("Seller", StringComparison.OrdinalIgnoreCase)))
        {
            Nav.NavigateTo("/seller/dashboard", true);
        }
        else
        {
            Nav.NavigateTo("/", true); // Customer về Home
        }
        return Task.CompletedTask;
    }
}
