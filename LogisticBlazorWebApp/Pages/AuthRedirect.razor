@page "/auth-redirect"
@inject TokenState TokenState
@inject NavigationManager Nav

@code {
    private bool _navigated; // chặn chạy lặp

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _navigated) return;

        // JS interop (localStorage) CHỈ được gọi ở đây khi có prerender
        await TokenState.LoadFromStorageAsync();

        var token = TokenState.AccessToken;
        if (string.IsNullOrWhiteSpace(token) || JwtHelper.IsExpired(token))
        {
            await TokenState.SetTokenAsync(null); // clear storage + header
            _navigated = true;
            Nav.NavigateTo("/login-seller-admin");
            return;
        }

        var roles = JwtHelper.GetRoles(token);
        _navigated = true;

        if (roles.Any(r => r.Equals("Admin", StringComparison.OrdinalIgnoreCase)))
            Nav.NavigateTo("/admin/dashboard");
        else if (roles.Any(r => r.Equals("Seller", StringComparison.OrdinalIgnoreCase)))
            Nav.NavigateTo("/seller/dashboard");
        else
            Nav.NavigateTo("/");
    }
}
