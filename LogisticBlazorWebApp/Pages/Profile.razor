@page "/profile"
@attribute [Authorize(Roles = "Seller,SuperAdmin,Admin,Customer,Shipper,WarehouseStaff,Accountant")]
@inject ProfileService profileService
@inject DonHangService donHangService
@inject DonHangHubService donHangHub
@inject IJSRuntime js
@inject NavigationManager nav
@inject UserStateService userState

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            @if (profile == null)
            {
                <div class="card p-4 shadow text-center">
                    <p>Đang tải thông tin...</p>
                </div>
            }
            else
            {
                <div class="card p-4 shadow rounded-4 text-center mb-4">
                    <h4 class="mb-4 text-primary">Thông Tin Cá Nhân</h4>

                    @if (!isEditing)
                    {
                        <p><strong>👤 Họ Tên:</strong> @profile.HoTen</p>
                        <p><strong>🎂 Ngày Sinh:</strong> @profile.NgaySinh.ToString("dd/MM/yyyy")</p>
                        <p><strong>🪪 CCCD:</strong> @profile.Cccd</p>
                        <p><strong>📍 Địa Chỉ:</strong> @profile.DiaChi</p>
                        <p><strong>📞 Số Điện Thoại:</strong> @profile.Sdt</p>
                        <p><strong>🎖️ Mã Vai Trò:</strong> @profile.MaVaiTro?.Trim()</p>

                        <div class="d-grid gap-2 mt-3">
                            <button class="btn btn-outline-primary" @onclick="BeginEdit">
                                <i class="fa-regular fa-pen-to-square me-2"></i>Chỉnh sửa
                            </button>

                            <button class="btn btn-danger" @onclick="Logout">
                                <i class="fa-solid fa-right-from-bracket me-2"></i>Đăng Xuất
                            </button>
                        </div>
                    }
                    else
                    {
                        <EditForm Model="editModel" OnValidSubmit="SaveProfile">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="text-start">
                                <div class="mb-2">
                                    <label class="form-label">Họ Tên</label>
                                    <InputText class="form-control" @bind-Value="editModel.HoTen" />
                                    <ValidationMessage For="@(() => editModel.HoTen)" />
                                </div>

                                <div class="mb-2">
                                    <label class="form-label">Ngày Sinh</label>
                                    <InputDate class="form-control" @bind-Value="editModel.NgaySinh" />
                                    <ValidationMessage For="@(() => editModel.NgaySinh)" />
                                </div>

                                <div class="mb-2">
                                    <label class="form-label">CCCD</label>
                                    <InputText class="form-control" @bind-Value="editModel.Cccd" />
                                    <ValidationMessage For="@(() => editModel.Cccd)" />
                                </div>

                                <div class="mb-2">
                                    <label class="form-label">Địa Chỉ</label>
                                    <InputText class="form-control" @bind-Value="editModel.DiaChi" />
                                    <ValidationMessage For="@(() => editModel.DiaChi)" />
                                </div>

                                <div class="mb-2">
                                    <label class="form-label">Số Điện Thoại</label>
                                    <InputText class="form-control" @bind-Value="editModel.Sdt" />
                                    <ValidationMessage For="@(() => editModel.Sdt)" />
                                </div>
                            </div>

                            <div class="d-grid gap-2 mt-3">
                                <button type="submit" class="btn btn-success" disabled="@isSaving">
                                    @(isSaving ? "Đang lưu..." : "Lưu thay đổi")
                                </button>
                                <button type="button" class="btn btn-secondary" @onclick="CancelEdit" disabled="@isSaving">
                                    Hủy
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>

                <!-- Danh sách đơn -->
                <div class="card p-4 shadow rounded-4">
                    <h5 class="mb-3 text-success">Danh Sách Đơn Hàng 🚚</h5>

                    @if (donHangs == null)
                    {
                        <p>Đang tải đơn hàng...</p>
                    }
                    else if (donHangs.Count == 0)
                    {
                        <p>Bạn chưa có đơn hàng nào.</p>
                    }
                    else
                    {
                        <ul class="list-group">
                            @foreach (var dh in donHangs)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong>Mã:</strong> @dh.MaDonHang <br />
                                        <strong>Trạng thái:</strong>
                                        <span class="@GetStatusClass(dh.TrangThai)">@dh.TrangThai</span>
                                    </div>
                                    <small>@dh.NgayDatDisplay</small>
                                </li>
                            }
                        </ul>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private UserProfileViewModel? profile;
    private List<DonHangViewModel>? donHangs;

    // --- Thêm state cho phần cập nhật profile ---
    private bool isEditing = false;
    private bool isSaving = false;
    private UserProfileUpdateModel editModel = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Lấy profile từ localStorage / API
            profile = await profileService.GetProfileAsync();

            // Lấy danh sách đơn hàng
            donHangs = await donHangService.GetAllDonHangOfUserAsync();

            // Kết nối SignalR
            await donHangHub.ConnectAsync();
            donHangHub.OnTrangThaiUpdated += CapNhatTrangThaiDon;

            if (donHangs != null)
            {
                foreach (var dh in donHangs)
                {
                    await donHangHub.JoinOrderGroup(dh.MaDonHang);
                }
            }

            StateHasChanged();
        }
    }

    private void BeginEdit()
    {
        if (profile == null) return;

        // Map từ profile sang editModel (đúng tên field UpdateModel của bạn)
        editModel = new UserProfileUpdateModel
        {
            HoTen = profile.HoTen,
            NgaySinh = profile.NgaySinh,   // InputDate nhận DateTime hoặc DateOnly tùy bạn định nghĩa
            Cccd = profile.Cccd,
            DiaChi = profile.DiaChi,
            Sdt = profile.Sdt
        };

        isEditing = true;
    }

    private void CancelEdit()
    {
        isEditing = false;
    }

    private async Task SaveProfile()
    {
        if (isSaving) return;
        isSaving = true;

        var ok = await profileService.UpdateProfileAsync(editModel);
        isSaving = false;

        if (ok)
        {
            // Refresh lại profile để hiển thị dữ liệu mới
            profile = await profileService.GetProfileAsync();
            isEditing = false;
            await js.InvokeVoidAsync("alert", "Cập nhật thông tin thành công!");
            StateHasChanged();
        }
        else
        {
            await js.InvokeVoidAsync("alert", "Cập nhật thất bại. Vui lòng thử lại!");
        }
    }

    private void CapNhatTrangThaiDon(string maDonHang, string trangThaiMoi)
    {
        var don = donHangs?.FirstOrDefault(x => x.MaDonHang == maDonHang);
        if (don != null)
        {
            don.TrangThai = MapTrangThai(trangThaiMoi);
            InvokeAsync(StateHasChanged);
        }
    }

    private string MapTrangThai(string maTrangThai)
    {
        return maTrangThai switch
        {
            "TT01" => "Chờ xác nhận",
            "TT02" => "Đang chuẩn bị",
            "TT03" => "Đang giao",
            "TT04" => "Hoàn tất",
            "TT05" => "Đã hủy",
            _ => maTrangThai
        };
    }

    private async Task Logout()
    {
        await js.InvokeVoidAsync("localStorage.removeItem", "accessToken");
        userState.Logout();
        nav.NavigateTo("/");
    }

    private string GetStatusClass(string trangThai)
    {
        return trangThai switch
        {
            "Đang giao" => "text-warning fw-bold",
            "Hoàn tất" => "text-success fw-bold",
            "Đã hủy" => "text-danger fw-bold",
            _ => "text-secondary"
        };
    }
}
