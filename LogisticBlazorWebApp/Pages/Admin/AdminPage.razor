@attribute [Authorize(Roles="Admin,SuperAdmin")]
@layout AdminLayout
@page "/admin/dashboard"


<h3 class="mb-4">Dashboard</h3>

<div class="row g-4">
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card card-stat p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-primary me-3"><i class="bi bi-truck"></i></div>
                <div>
                    <div class="text-muted small">Shipments (Today)</div>
                    <div class="fs-4 fw-semibold">128</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card card-stat p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-success me-3"><i class="bi bi-box-seam"></i></div>
                <div>
                    <div class="text-muted small">Items In Stock</div>
                    <div class="fs-4 fw-semibold">12,540</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card card-stat p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-warning me-3"><i class="bi bi-receipt"></i></div>
                <div>
                    <div class="text-muted small">Open Orders</div>
                    <div class="fs-4 fw-semibold">312</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-md-6 col-xl-3">
        <div class="card card-stat p-3">
            <div class="d-flex align-items-center">
                <div class="icon text-danger me-3"><i class="bi bi-exclamation-triangle"></i></div>
                <div>
                    <div class="text-muted small">Low Stock Alerts</div>
                    <div class="fs-4 fw-semibold">9</div>
                </div>
            </div>
        </div>
    </div>
</div>
