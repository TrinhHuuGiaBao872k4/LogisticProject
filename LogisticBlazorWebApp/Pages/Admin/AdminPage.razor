@inherits LayoutComponentBase

<div class="admin-app d-flex">
    <!-- Sidebar cố định (ẩn trên mobile) -->
    <AdminSidebar class="d-none d-md-flex" />

    <!-- Phần nội dung chính -->
    <div class="flex-grow-1 d-flex flex-column min-vh-100">
        <AdminTopbar />

        <main class="container-fluid py-4">
            @Body
        </main>

        <footer class="mt-auto border-top py-3 bg-body">
            <div class="container-fluid small text-muted d-flex justify-content-between">
                <span>© @DateTime.Now.Year Logistic Admin</span>
                <span>v1.0.0</span>
            </div>
        </footer>
    </div>
</div>

<!-- Offcanvas sidebar cho mobile -->
<div class="offcanvas offcanvas-start" tabindex="-1" id="offcanvasSidebar">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Menu</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body p-0">
        <AdminSidebar />
    </div>
</div>

<link rel="stylesheet" href="css/admin.css" />
