@inject NavigationManager nav
@inject IJSRuntime js
@inject UserStateService userState

<nav class="navbar navbar-expand-lg navbar-dark bg-gradient-custom shadow-sm">
  <div class="container-fluid">
    <!-- Logo -->
    <a class="navbar-brand fw-bold fs-4" href="/">
      <i class="fa-solid fa-truck"></i>
      LogisticCyber
    </a>

    <!-- Toggle button for mobile -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
      aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navbar content -->
    <div class="collapse navbar-collapse" id="navbarContent">
      <!-- Left Menu -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0">
        <li class="nav-item">
          <NavLink class="nav-link" href="/" Match="NavLinkMatch.All" ActiveClass="active_link">Trang Chủ</NavLink>
        </li>
        <li class="nav-item">
          <NavLink class="nav-link" href="/Product-list" ActiveClass="active_link">Sản Phẩm</NavLink>
        </li>
        <li class="nav-item">
          <NavLink class="nav-link" href="/Aboutus" ActiveClass="active_link">Về Chúng Tôi</NavLink>
        </li>
      </ul>

      <!-- Right: Cart + Auth -->
      <ul class="navbar-nav mb-2 mb-lg-0">
        <li class="nav-item">
          <CartIcon />
        </li>

        @if (userState.IsLoggedIn)
        {
          <li class="nav-item">
            <span class="nav-link fw-bold">Xin Chào @userState.TenDangNhap</span>
          </li>
          <li class="nav-item">
            <NavLink class="nav-link" href="/profile">Trang Cá Nhân</NavLink>
          </li>
          <li class="nav-item">
            <a class="nav-link text-danger" style="cursor: pointer;" @onclick="Logout">Đăng Xuất</a>
          </li>
        }
        else
        {
          <li class="nav-item">
            <NavLink class="nav-link" href="/login" ActiveClass="active_link">Đăng Nhập</NavLink>
          </li>
          <li class="nav-item">
            <NavLink class="nav-link" href="/register" ActiveClass="active_link">Đăng Ký</NavLink>
          </li>
        }
      </ul>
    </div>
  </div>
</nav>

@code {
  protected override void OnInitialized()
  {
    userState.OnChange += OnUserStateChanged;
  }

  private async void OnUserStateChanged()
  {
    await InvokeAsync(StateHasChanged);
  }

  private async Task Logout()
  {
    await js.InvokeVoidAsync("localStorage.removeItem", "accessToken");
    userState.Logout();
    nav.NavigateTo("/");
  }
}
